require cargo

SUMMARY="A CLI to manage your Otoroshi clusters with style"
HOMEPAGE="https://cloud-apim.github.io/otoroshictl"

LICENCES="Apache-2.0"
SLOT="0"
PLATFORMS="~amd64 ~armv8"

DEPENDENCIES=""

src_test() {
    # challenge and sidecar tests run local servers
    esandbox allow_net --connect "inet:127.0.0.1@1024-65535"

    cargo_src_test

    esandbox disallow_net --connect "inet:127.0.0.1@1024-65535"
}

