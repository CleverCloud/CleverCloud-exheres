require php-pecl [ module=module php_abis=[ 8.4 8.5 8.6 ] work="/" ]

SUMMARY="Microsoft Drivers for PHP for SQL Server (SQLSRV)"
DOWNLOADS="https://github.com/microsoft/msphpsql/releases/download/v${PV}/${PN}-v${PV}.tgz -> ${PNV}.tgz"
PLATFORMS="~amd64"
LICENCES="MIT"
SLOT="5.14"

DEPENDENCIES="
    build+run:
        dev-db/unixODBC
"

