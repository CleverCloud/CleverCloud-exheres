Newer vlang/tccbin runtimes (tinycc 85ba3ae8, July 2026) export atomic_thread_fence
instead of __atomic_thread_fence. Map the old name onto the new one so the C code
generated by V 0.5.1 still links with the bundled tcc.

Upstream fixed this differently after 0.5.2: vlang/v@8eb7f317b5

--- a/thirdparty/stdatomic/nix/atomic.h
+++ b/thirdparty/stdatomic/nix/atomic.h
@@ -62,7 +62,8 @@
     #define atomic_thread_fence(order) _V_atomic_thread_fence(order)
     #define __atomic_thread_fence(order) _V_atomic_thread_fence(order)
 #else
-    #define atomic_thread_fence(order) __atomic_thread_fence(order)
+    // newer tccbin runtimes export atomic_thread_fence, not __atomic_thread_fence
+    #define __atomic_thread_fence(order) atomic_thread_fence(order)
 #endif
 #endif
 
