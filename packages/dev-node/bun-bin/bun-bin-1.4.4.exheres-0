require bash-completion zsh-completion

SUMMARY="Incredibly fast JavaScript runtime, bundler, test runner, and package manager all in one"
HOMEPAGE="https://bun.sh/"

MY_PN="bun"

DOWNLOADS="
    platform:amd64? ( https://github.com/oven-sh/bun/releases/download/bun-v${PV}/bun-linux-x64.zip -> ${PNV}.zip )
    platform:armv8? ( https://github.com/oven-sh/bun/releases/download/bun-v${PV}/bun-linux-aarch64.zip -> ${PNV}.zip )
"

LICENCES="MIT"
SLOT="0"
PLATFORMS="~amd64 ~armv8"
MYOPTIONS="
    ( platform: amd64 armv8 )
"

DEPENDENCIES=""

WORK="${WORKBASE}"

case "${PLATFORM}" in
  "amd64") PN_ARCH="linux-x64" ;;
  "armv8") PN_ARCH="linux-aarch64" ;;
esac

src_compile() {
    SHELL=bash edo ${MY_PN}-${PN_ARCH}/${MY_PN} completions > ${MY_PN}.bash
    SHELL=zsh edo ${MY_PN}-${PN_ARCH}/${MY_PN} completions > _${MY_PN}
}

src_install() {
    dobin ${MY_PN}-${PN_ARCH}/${MY_PN}
    # bunx is bun itself, run under that name: the official installer creates the same symlink
    dosym ${MY_PN} /usr/$(exhost --target)/bin/${MY_PN}x

    dobashcompletion ${MY_PN}.bash ${MY_PN}
    dozshcompletion _${MY_PN}
}

