# PostgreSQL 14 and 15 keep the copy bundled in dev-db/postgis:3.6
require github [ user="postgis" tag="v${PV}" ]
require postgresql [ min_version="16" ]

SUMMARY="PostgreSQL extension to parse addresses into constituent elements"
HOMEPAGE+=" https://postgis.net/"
LICENCES="MIT"
SLOT="0"
PLATFORMS="~amd64"

DEPENDENCIES="
    build+run:
        dev-libs/pcre2
"

RESTRICT="test"

# No update path from the copies bundled in postgis <3.7: tag them as ANY, versions as in postgis_tiger_geocoder
install_one_multibuild() {
    default

    local e v dir="${IMAGE}"/usr/share/postgresql-${MULTIBUILD_TARGET}/extension
    for e in address_standardizer address_standardizer_data_us; do
        for v in 3.2.10 3.3.10 3.4.6 3.5.4 3.5.5 3.5.6 3.5.7 3.6.0 3.6.1 3.6.2 3.6.3 3.6.4; do
            echo "-- Just tag extension ${e} version as \"ANY\"" | edo tee "${dir}"/${e}--${v}--ANY.sql
        done
    done
}
