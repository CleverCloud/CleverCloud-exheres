myexparam min_version=
myexparam max_version=

# avx512 target features are stable since rust 1.89
require cargo [ rust_minimum_version=1.89.0 ]
require github [ user=supervc-stack ]
require postgresql [ min_version="$(exparam min_version)" max_version="$(exparam max_version)" ]

export_exlib_phases src_configure

SUMMARY="Scalable, fast and disk-friendly vector search in PostgreSQL"
DESCRIPTION="
VectorChord (vchord) is a PostgreSQL extension for vector similarity search,
built on top of the pgvector data types.
"

LICENCES="|| ( AGPL-3 Elastic-License-2.0 )"
SLOT="0"
MYOPTIONS=""

DEPENDENCIES="
    build:
        dev-lang/clang:*
    run:
        dev-db/pgvector:0[postgresql_servers:*(-)?]
"

unpack_one_multibuild() {
    default

    # Vendor once: every slot finds ${WORKBASE}/.cargo/config.toml
    if [[ ! -d ${WORKBASE}/ecargo-vendor ]]; then
        edo pushd "${PNV}"
        ecargo_fetch
        edo popd
    fi
}

VectorChord_src_configure() {
    ecargo_config
    easy-multibuild_src_configure
}

compile_one_multibuild() {
    # xtask reads PG_CONFIG, exported per slot by postgresql.exlib
    ecargo run --frozen -p xtask -- build --target "$(rust_target_arch_name)"
}

