# Since 2.59.0 the autogenerated tag archive lacks pregenerated code
# (build/common/*.c); upstream provides a distribution tarball as release asset.
require github [ release="release/${PV}" suffix="tar.gz" ]
require meson

SUMMARY="Reliable PostgreSQL Backup & Restore"

LICENCES="MIT"
PLATFORMS="~amd64"
SLOT="0"

MYOPTIONS="
    zstd
"

DEPENDENCIES="
    build:
        dev-libs/libyaml
    build+run:
	app-arch/bzip2
        app-arch/lz4
        dev-db/postgresql-client
	dev-libs/libxml2:2.0
	net-libs/libssh2
	dev-libs/openssl:=
	sys-libs/zlib
	zstd? ( app-arch/zstd )
"

MESON_SRC_CONFIGURE_PARAMS=(
    -Dlibssh2=enabled
)

MESON_SRC_CONFIGURE_OPTION_FEATURES=(
    'zstd libzstd'
)

src_test() {
    # The smoke test starts real PostgreSQL clusters which bind unix sockets
    esandbox allow_net --bind 'unix:/tmp/pgbackrest-smoke-*/socket/.s.PGSQL.*'
    esandbox allow_net --connect 'unix:/tmp/pgbackrest-smoke-*/socket/.s.PGSQL.*'

    meson_src_test

    esandbox disallow_net --bind 'unix:/tmp/pgbackrest-smoke-*/socket/.s.PGSQL.*'
    esandbox disallow_net --connect 'unix:/tmp/pgbackrest-smoke-*/socket/.s.PGSQL.*'
}

