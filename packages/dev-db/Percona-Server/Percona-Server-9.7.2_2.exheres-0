require Percona-Server

PLATFORMS="~amd64 ~x86"

CMAKE_SRC_CONFIGURE_PARAMS+=(
    -DDEFAULT_CHARSET:STRING=utf8mb4
    -DDEFAULT_COLLATION:STRING=utf8mb4_0900_ai_ci
    -DINSTALL_PRIV_LIBDIR:PATH=$(exhost --target)/lib/${PN}-${SLOT}/private
)

src_configure() {
    cmake_src_configure

    edo mkdir -p share/${PN}-${SLOT}
    edo cp -r "${CMAKE_SOURCE}"/share/charsets share/${PN}-${SLOT}/
}

src_install() {
    Percona-Server_src_install

    edo mv "${IMAGE}"/usr/bin/mysqlrouter_bootstrap \
        "${IMAGE}"/usr/$(exhost --target)/libexec/${PN}-${SLOT}/
    edo rmdir "${IMAGE}"/usr/bin
}
