require github [ user=confluentinc tag=v${PV} ]

SUMMARY="The Apache Kafka C/C++ library"

LICENCES="BSD-2"
SLOT="0"
PLATFORMS="~amd64"

MYOPTIONS="
    doc
    sasl
    ssl
    ssl? ( ( providers: libressl openssl ) [[ number-selected = exactly-one ]] )
"

DEPENDENCIES="
    build+run:
        app-arch/lz4
        app-arch/zstd
        net-misc/curl
        sys-libs/zlib
        doc? (
            app-doc/doxygen
            media-gfx/graphviz
        )
        sasl? ( net-libs/cyrus-sasl )
        ssl? (
            providers:libressl? ( dev-libs/libressl:= )
            providers:openssl? ( dev-libs/openssl:= )
        )
"

src_configure(){
    econf \
        --hates=datarootdir \
        --hates=docdir \
        --hates=enable-fast-install \
        --enable-curl \
        --enable-lz4-ext \
        --enable-zlib \
        --enable-zstd \
        $(option_enable sasl) \
        $(option_enable ssl)
}

src_compile(){
    default

    if optionq doc; then
        emake docs
    fi
}

src_install(){
    default
    if optionq doc; then
        edo cd staging-docs && dodoc -r ./{html,latex}
    else
        edo rm "${IMAGE}"/usr/share/doc -r
        edo rmdir "${IMAGE}"/usr/share
    fi
}

