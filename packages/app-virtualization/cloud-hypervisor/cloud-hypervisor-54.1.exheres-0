require cargo [ rust_minimum_version=1.89.0 crate_path=${PN} ]
require github [ tag=v${PV} ]

SUMMARY="A rust-vmm based cloud hypervisor"

LICENCES="Apache-2.0 BSD-3"
SLOT="0"
PLATFORMS="~amd64"
MYOPTIONS=""

DEPENDENCIES="
    build+run:
        sys-fs/lvm2
"

# integration tests need KVM and guest images
CARGO_SRC_TEST_PARAMS=( --lib --bins )

