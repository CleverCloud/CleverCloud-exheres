# Slot of kubernetes/konnectivity-server to pair with this apiserver. Defaults
# to 0.<kubernetes minor>, but apiserver-network-proxy releases lag behind
# kubernetes, so a new minor may have to use the previous slot for a while
myexparam konnectivity_slot="0.$(ever range 2)"

SUMMARY="Meta-package to provides kubernetes components for an apiserver node"

SLOT="$(ever range 1-2)"
DEPENDENCIES="
    run:
        kubernetes/kube-apiserver:${SLOT}
        kubernetes/konnectivity-server:$(exparam konnectivity_slot)
        virtual/kubernetes-clients:${SLOT}
"
